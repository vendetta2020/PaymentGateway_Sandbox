# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=paymentgw
DB_PASSWORD=paymentgw_secret
DB_NAME=payment_gateway

# Features
# Enable to allow creating API credentials via internal endpoints (development only)
ALLOW_DEV_CREDENTIAL_PROVISIONING=true
# Enable to allow state transition of payments via internal endpoints (development only)
ALLOW_DEV_PAYMENT_SIMULATION=true
# Enable to allow manual webhook delivery trigger via internal endpoints (development only)
ALLOW_DEV_WEBHOOK_DELIVERY=true
# Enable to allow webhook delivery to localhost/127.0.0.1 in development/testing
ALLOW_DEV_LOCAL_WEBHOOKS=true
